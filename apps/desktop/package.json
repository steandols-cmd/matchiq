{
  "name": "matchiq-desktop",
  "productName": "MatchIQ",
  "private": true,
  "version": "1.0.0",
  "description": "MatchIQ – statistisk prognosmotor för fotboll (desktop)",
  "author": "MatchIQ",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/backend.test.js",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  }
}
